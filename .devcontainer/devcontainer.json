{
  "name": "SR-01 Laboratorio bajo demanda",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "forwardPorts": [3000, 4200, 8000, 8080, 9000],
  "portsAttributes": {
    "3000": { "label": "Portal SR-01", "onAutoForward": "openBrowser" },
    "4200": { "label": "Fleetbase Console", "onAutoForward": "silent" },
    "8000": { "label": "Fleetbase API", "onAutoForward": "silent" },
    "8080": { "label": "ERPNext", "onAutoForward": "silent" },
    "9000": { "label": "frePPLe", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/prepare.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "remoteUser": "vscode"
}
